# Toolbox for the opt-in Android Pocket handoff test: JDK 21 (Capacitor 8 /
# AGP 8.13), Node, and the shared libraries the Android emulator needs. The
# Android SDK itself lives in a bind-mounted cache directory, not in the image.
FROM docker.io/library/eclipse-temurin:21-jdk-jammy
ARG NODE_VERSION=22.23.3
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip xz-utils git procps iproute2 \
      libpulse0 libnss3 libx11-6 libxkbfile1 libgl1 libasound2 libxcomposite1 \
      libxcursor1 libxdamage1 libxi6 libxtst6 libxrandr2 libdbus-1-3 libxfixes3 \
      libxext6 libxrender1 libxshmfence1 libgbm1 libc6 libstdc++6 libncurses5 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
       | tar -xJ -C /usr/local --strip-components=1
ENV ANDROID_HOME=/opt/android-sdk ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:$PATH
